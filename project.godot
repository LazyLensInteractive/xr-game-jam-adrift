; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="XR game jam Adrift"
run/main_scene="uid://sg4feqn4e514"
config/features=PackedStringArray("4.8", "Mobile")
config/icon="res://icon.svg"

[autoload]

Data="*uid://rqu7pmwyu6bs"
Events="*uid://c5vtxnp43kjog"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-development-kit/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg")

[global_group]

book="book"

[gui]

common/auto_focus_strategy=1

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/multi_bounce_occlusion/enabled=true

[xr]

openxr/enabled=true
shaders/enabled=true
